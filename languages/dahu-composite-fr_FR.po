msgid "“%1$s”: anchored to “%2$s”, which shows no product cards (a branching or add-on component). It is shown in its usual place."
msgstr "« %1$s » : ancré à « %2$s », qui n’affiche aucune carte produit (composant de branchement ou complément). Il est affiché à sa place habituelle."

#. translators: 1: component, 2: category */
#: includes/class-dahu-composite-validator.php:162
msgid "“%1$s”: category “%2$s” has no options."
msgstr "« %1$s » : la catégorie « %2$s » n’a aucune option."

#. translators: 1: component, 2: option, 3: category identifier */
#: includes/class-dahu-composite-validator.php:152
msgid "“%1$s”: option “%2$s” is attached to category “%3$s”, which does not exist. It is shown without a category."
msgstr "« %1$s » : l’option « %2$s » est rattachée à la catégorie « %3$s », qui n’existe pas. Elle est affichée sans catégorie."

#. translators: 1: component, 2: label */
#: includes/class-dahu-composite-validator.php:171
msgid "“%1$s”: two categories are called “%2$s”."
msgstr "« %1$s » : deux catégories s’appellent « %2$s »."

#. translators: 1: product */
#: includes/class-dahu-composite-engine.php:708
msgid "“%s” can only be ordered one at a time."
msgstr "« %s » ne peut être commandé qu’à l’unité."

#. translators: %s: option */
#: includes/class-dahu-composite-engine.php:578
msgid "“%s” cannot be ordered yet."
msgstr "« %s » ne peut pas encore être commandé."

#: includes/class-dahu-composite-cart.php:317
msgid "“%s” could not be added to the cart."
msgstr "« %s » n’a pas pu être ajouté au panier."

#: includes/class-dahu-composite-order.php:668
msgid "“%s” could not be added to the order."
msgstr "« %s » n’a pas pu être ajouté à la commande."

#: includes/class-dahu-composite-saved-configs.php:333
msgid "“%s” is no longer compatible with your other choices: it was removed."
msgstr "« %s » n’est plus compatible avec vos autres choix : il a été retiré."

#: includes/class-dahu-composite-saved-configs.php:377
msgid "“%s” is no longer offered: it was removed."
msgstr "« %s » n’est plus proposé : il a été retiré."

#. translators: %s: component */
#: includes/class-dahu-composite-engine.php:554
msgid "“%s” is not available with the configuration you chose."
msgstr "« %s » n’est pas disponible avec la configuration que vous avez choisie."

#. translators: 1: product */
#: includes/class-dahu-composite-engine.php:712
msgid "“%s” is out of stock."
msgstr "« %s » est en rupture de stock."

#: includes/class-dahu-composite-saved-configs.php:382
msgid "“%s” is out of stock: it was removed."
msgstr "« %s » est en rupture de stock : il a été retiré."

#. translators: %s: option */
#: includes/class-dahu-composite-engine.php:581
msgid "“%s” links to another page: it is not a choice of this product."
msgstr "« %s » renvoie vers une autre page : ce n’est pas un choix de ce produit."

#: includes/class-dahu-composite-saved-configs.php:328
msgid "“%s” was chosen instead, as the only variation still available: please check it."
msgstr "« %s » a été retenue à la place, comme seule variation encore disponible : merci de la vérifier."

#: includes/class-dahu-composite-kit-config.php:393
msgid "“%s”: incomplete anchoring (a card with no anchor component). It is shown in its usual place."
msgstr "« %s » : ancrage incomplet (une carte sans composant d’ancrage). Il est affiché à sa place habituelle."

#. translators: %s: component */
#: includes/class-dahu-composite-validator.php:233
msgid "“%s”: the “Anchor next to” setting only applies to an “add-on” component (secondary, optional, a single option). Ignored."
msgstr "« %s » : le réglage « Ancrer à côté de » ne vaut que pour un composant « complément » (secondaire, facultatif, une seule option). Ignoré."

#. translators: %s: component */
#: includes/class-dahu-composite-validator.php:217
msgid "“%s”: the “Yes / no question” presentation only applies to an “add-on” component (secondary, optional, a single option). It is shown as cards."
msgstr "« %s » : la présentation « Question oui / non » ne vaut que pour un composant « complément » (secondaire, facultatif, une seule option). Il est affiché en cartes."

#: includes/class-dahu-composite-validator.php:439
msgid "“%s”: too many combinations to explore, so the dead-end check could not run. Check it by hand."
msgstr "« %s » : trop de combinaisons à explorer, le contrôle d’impasse n’a pas pu s’exécuter. À vérifier à la main."

