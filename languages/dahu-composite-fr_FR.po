msgid "“%1$s”: anchored next to component “%2$s”, which does not exist. It is shown in its usual place."
msgstr "« %1$s » : ancré à côté du composant « %2$s », qui n’existe pas. Il est affiché à sa place habituelle."

#. translators: 1: component, 2: product, 3: anchor component */
#: includes/class-dahu-composite-validator.php:269
msgid "“%1$s”: anchored next to product #%2$d, which is not among the options of “%3$s”. It is shown in its usual place."
msgstr "« %1$s » : ancré à côté du produit n° %2$d, qui ne fait pas partie des options de « %3$s ». Il est affiché à sa place habituelle."

#. translators: 1: component, 2: anchor component */
#: includes/class-dahu-composite-validator.php:279
