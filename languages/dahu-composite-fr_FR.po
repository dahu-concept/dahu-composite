msgstr "« %1$s » : ancré à « %2$s », qui n’est pas sur le même écran (groupe d’affichage différent). Il est affiché à sa place habituelle."

#. translators: 1: component, 2: anchor component */
#: includes/class-dahu-composite-validator.php:252
msgid "“%1$s”: anchored to “%2$s”, which shows no product cards (a branching or add-on component). It is shown in its usual place."
msgstr "« %1$s » : ancré à « %2$s », qui n’affiche aucune carte produit (composant de branchement ou complément). Il est affiché à sa place habituelle."

#. translators: 1: component, 2: category */
#: includes/class-dahu-composite-validator.php:162
msgid "“%1$s”: category “%2$s” has no options."
msgstr "« %1$s » : la catégorie « %2$s » n’a aucune option."

